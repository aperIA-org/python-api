# ── GitHub App ────────────────────────────────────────────────────────────
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=/secrets/github_private_key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_TOKEN=ghp_your_token

# ── Claude API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key

# ── OWASP ZAP ────────────────────────────────────────────────────────────
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=your_zap_api_key

# ── OpenVAS / Greenbone ───────────────────────────────────────────────────
OPENVAS_HOST=openvas
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=change_me

# ── Wazuh ─────────────────────────────────────────────────────────────────
WAZUH_BASE_URL=https://wazuh-manager:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=change_me

# ── AWS (Prowler CSPM) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEFAULT_REGION=us-east-1

# ── OpenCTI ───────────────────────────────────────────────────────────────
OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=your_opencti_token

# ── MITRE Caldera ─────────────────────────────────────────────────────────
CALDERA_URL=http://caldera:8888
CALDERA_API_KEY=your_caldera_api_key
CALDERA_SANDBOX_MODE=true
CALDERA_AGENT_GROUP=aperia-sandbox

# ── LLM Guard ─────────────────────────────────────────────────────────────
LLM_GUARD_ENABLED=true
LLM_GUARD_BASE_URL=http://llm_guard:8010

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aperia:change_me@postgres:5432/aperia
REDIS_URL=redis://:change_me@redis:6379/0

# ── App ───────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
