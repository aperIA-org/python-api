# =============================================================================
# aperIA — exemplo de configuração. Copie para .env e preencha.
#   cp .env.example .env
# O .env é gitignored (nunca commite segredos). Valores aqui são placeholders.
# =============================================================================

# ---- Auth / JWT ----
# Chave de assinatura dos JWT (access token + state do GitHub connect).
# Gere uma forte (>= 32 chars): openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Banco de dados (PostgreSQL) ----
# Opção A: uma URL única (tem precedência sobre as DB_* abaixo).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/postgres
# Opção B: partes separadas (default aponta para o serviço "db" do compose).
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# true força resolução IPv4 (útil em alguns provedores gerenciados).
DB_FORCE_IPV4=false

# =============================================================================
# GitHub App  —  AS VARIÁVEIS QUE FALTAM PARA A CONEXÃO DE CONTA/REPOS
# -----------------------------------------------------------------------------
# Você registra UM GitHub App (self-service, ~10 min, SEM aprovação) e cada
# usuário instala esse App na conta/org dele. Passo a passo:
#
# 1. Acesse  https://github.com/settings/apps  →  "New GitHub App".
#
# 2. GitHub App name: escolha um nome. O "slug" é o nome em minúsculas com
#    hífens e aparece na URL pública  https://github.com/apps/<slug>
#    →  GITHUB_APP_SLUG   (ex.: nome "aperIA Scanner" → slug "aperia-scanner")
#
# 3. Homepage URL: a URL do seu site (qualquer, obrigatória).
#
# 4. Webhook:
#    - Webhook URL:  https://SEU-DOMINIO/webhook/github
#    - Secret: gere com  openssl rand -hex 32  e cole no campo Secret.
#      O MESMO valor vai em  →  GITHUB_WEBHOOK_SECRET
#
# 5. Setup URL (em "Post installation" / "Setup URL (optional)"):
#      https://SEU-DOMINIO/github/callback
#    marque "Redirect on update". É para onde o GitHub redireciona o usuário
#    após instalar, entregando installation_id + o nosso `state`.
#    (Em dev local sem HTTPS público, use um túnel tipo ngrok/cloudflared.)
#
# 6. Permissions (Repository permissions):
#      - Pull requests:   Read and write   (postar comentários/suggestions)
#      - Contents:        Read-only        (ler arquivos p/ contexto)
#      - Commit statuses: Read and write   (status check do PR)
#    Subscribe to events:  Pull request  e  Installation.
#
# 7. "Where can this GitHub App be installed?":  Any account
#    (deixa o App público — sem Marketplace/aprovação — para outros usuários
#     instalarem via a URL que GET /github/connect gera).
#
# 8. Clique "Create GitHub App". Na página do App:
#    - "App ID" (no topo)                       →  GITHUB_APP_ID
#    - "Generate a private key" baixa um .pem, com nome no formato
#      <slug>.<AAAA-MM-DD>.private-key.pem. Copie o arquivo COMO ESTÁ para o
#      diretório ./secrets/ deste repositório e aponte GITHUB_PRIVATE_KEY_PATH
#      para /app/secrets/<mesmo-nome-do-arquivo>.
#
#      A chave entra no container SÓ pelo bind mount `./secrets:/app/secrets:ro`
#      declarado no docker-compose.base.yml (api, worker_tier1, worker_tier2,
#      worker_analysis, worker_reporting). Ela NÃO deve ser copiada para dentro
#      da imagem: `app/secrets/` e `**/*.pem` estão no .dockerignore justamente
#      porque uma chave assada na imagem viaja em toda camada e todo
#      `docker push`. Por isso o caminho aqui é ABSOLUTO (/app/...), o caminho
#      de dentro do container — não um caminho relativo do host.
#      Detalhes em secrets/README.md e docs/howto/subir-a-stack.md.
# =============================================================================
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=seu-app-slug
GITHUB_PRIVATE_KEY_PATH=/app/secrets/seu-app-slug.2026-01-01.private-key.pem
GITHUB_WEBHOOK_SECRET=troque-por-outro-valor-aleatorio
# Para onde o /github/callback manda o BROWSER do usuário depois da instalação.
# É uma tela do front-end (não uma rota da API): ela lê a query string para
# saber como foi o retorno e então recarrega a lista de repositórios.
#   - sucesso  → redireciona para a URL exatamente como configurada aqui,
#                por isso o `?github=conectado` já vai embutido no valor;
#   - `state` inválido/expirado → redireciona para a mesma URL com
#                `github=erro&motivo=state` (substitui o `github=conectado`
#                e preserva os demais parâmetros que você tiver posto).
# Vazio → o callback responde JSON (sucesso) / 400 (state inválido), sem 302.
GITHUB_CONNECT_REDIRECT_URL=http://localhost:3000/dash/repositorios?github=conectado

# ---- Anthropic / Claude ----
# Chave da API (console.anthropic.com). Sem ela, a análise/relatórios dos
# tiers 2/3 rodam em modo degradado (sem a narrativa do Claude).
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_REASONING=claude-sonnet-4-6
CLAUDE_MODEL_FORMATTING=claude-haiku-4-5-20251001
CLAUDE_PROMPT_CACHE_ENABLED=true

# ---- Celery / Redis ----
REDIS_URL=redis://redis:6379/0
# Vazios → derivam de REDIS_URL. Não use EAGER=true em produção.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# ---- Persistência (best-effort; testes desligam) ----
FINDINGS_PERSISTENCE_ENABLED=true
SCAN_PERSISTENCE_ENABLED=true
# Minutos sem progresso a partir dos quais um ScanJob ainda "queued"/"running"
# é considerado TRAVADO e marcado como "failed". Um job travado é aquele cuja
# tarefa Celery não existe mais (fila perdida num restart da stack, worker
# morto): ninguém vai concluí-lo, e enquanto ele existir o commit fica barrado
# com 409 em POST /repositories/{id}/scan. A liberação acontece em dois pontos:
# na varredura de boot da API e na hora de um novo disparo.
# Suba o valor se seus pipelines de tier 3 (ZAP/Caldera) passam de 30 min.
SCAN_STALE_AFTER_MINUTES=30

# ---- Checkout do repositório ----
# Teto, em segundos, para cada operação de rede do checkout efêmero que os
# workers de Tier 1/Tier 2 fazem antes de escanear (fetch raso do commit).
# Existe para que um repositório enorme ou uma conexão pendurada não prendam o
# worker indefinidamente. Suba se seus repositórios são muito grandes.
REPO_CHECKOUT_TIMEOUT=300

# ---- Tier 3 — ferramentas pesadas (opcionais; só se subir a stack de scanners) ----
# DAST (OWASP ZAP)
ZAP_BASE_URL=http://zap:8090
# Precisa bater com o que o container do ZAP recebe — o MESMO nome de variável
# alimenta os dois lados (app e `docker-compose.scanners.yml`). Deixar em branco
# aqui usa o default "changeme" nos dois; em produção, defina um valor real.
ZAP_API_KEY=changeme
#
# Memória do container do ZAP. As DUAS variáveis são lidas por
# `docker-compose.scanners.yml`, não pelo app — e precisam andar juntas:
# ZAP_JVM_HEAP deve ser ~METADE de ZAP_MEM_LIMIT. O ZAP é uma JVM e o `zap.sh`
# não enxerga o limite de cgroup v2, então sem `-Xmx` explícito ele dimensiona
# o heap pela RAM do host e o kernel mata o container (Exited 137). O restante
# do limite não é desperdício: é metaspace, code cache, stacks e buffers
# diretos, que ficam fora do heap. Detalhe completo no comentário do compose.
ZAP_MEM_LIMIT=2g
ZAP_JVM_HEAP=1g
#
# Tetos do scan, aplicados no lado do ZAP para que ele ENCERRE sozinho em vez
# de ser abandonado pelo cliente (scan abandonado = zero findings, mesmo tendo
# achado coisa). Suba se seu alvo é pequeno e você quer cobertura maior; o
# custo é tempo de pipeline. `0` desliga o teto correspondente.
ZAP_SPIDER_MAX_DURATION_MIN=3
ZAP_SPIDER_MAX_CHILDREN=10
ZAP_ASCAN_MAX_DURATION_MIN=10
ZAP_ASCAN_MAX_RULE_DURATION_MIN=2
ZAP_ASCAN_THREADS_PER_HOST=2
# Regras de active scan desligadas (ids separados por vírgula; vazio = todas
# ligadas). 40026 é o DOM XSS: para avaliar DOM ele sobe Firefox headless DE
# VERDADE dentro do container do ZAP — medido, os navegadores consumiam mais
# que o JVM inteiro e sozinhos empurravam o container para o teto de memória.
# Nenhum ajuste de heap conserta isso, porque a memória não é do heap.
ZAP_ASCAN_DISABLED_RULES=40026
# Threat Intel (OpenCTI) — token em Settings → Security da sua instância
OPENCTI_URL=http://opencti:8081
OPENCTI_TOKEN=
# Adversary Emulation (Caldera) — API key do config do Caldera
CALDERA_URL=http://caldera:8888
# Precisa ser IGUAL a `api_key_red` em `caldera/local.yml` (montado no container
# do Caldera). A imagem do Caldera gera uma chave aleatória por versão — é por
# isso que fixamos a chave por config montado em vez de tentar alinhar defaults.
CALDERA_API_KEY=aperia-dev-caldera-red
# INVIOLÁVEL: mantenha true (sandbox). false é bloqueado no código.
CALDERA_SANDBOX_MODE=true
CALDERA_POLL_INTERVAL=10
CALDERA_AGENT_GROUP=red
# PAW (identificador) fixo do agente sandcat. Lido SÓ pelo compose — a API não
# precisa dele, ela fala com o grupo. Existe porque sem `-paw` o sandcat pede um
# identificador novo a cada boot: como o serviço tem `restart: unless-stopped`,
# cada reinício registrava um agente A MAIS (chegamos a 20 para um container).
# Uma operação roda cada ability em TODOS os agentes do grupo, então isso
# multiplicava a execução de técnicas reais e falseava o `success_rate`.
CALDERA_AGENT_PAW=aperia-sandbox

# ---- AI Security ----
LLM_GUARD_ENABLED=true

# Libera alvo de DAST em rede interna (localhost, RFC1918, host de rótulo único).
# APENAS desenvolvimento: em produção, alvo interno significa usar o aperIA para
# atacar a própria infraestrutura — inclusive o endpoint de metadata de cloud.
# Necessária para apontar a target_url para o Juice Shop local
# (docker-compose.targets.yml), que responde em http://juice-shop:3000.
ALLOW_INTERNAL_DAST_TARGETS=false
